# Copy this file to ".env" and fill in a key. NEVER commit ".env".
#
# The app works WITHOUT any key (it uses the rule-based router). Adding a key
# enables optional LLM-assisted natural-language routing. The provider is chosen
# by which key is set: anthropic > openai > google. In the standard modes the
# LLM only SELECTS one of the supported question templates - it never writes code.
#
# A key also unlocks the experimental "Advanced: AI writes code" mode, where the
# LLM writes pandas code that runs in a restricted sandbox (no imports, files, or
# network) and is validated before display. Tuning for it is below.

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional tuning
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Optional: experimental LLM code-generation agent (advanced mode)
CODEGEN_MAX_ATTEMPTS=3
CODEGEN_TIMEOUT_SECONDS=10
CODEGEN_MAX_ROWS=5000
CODEGEN_MAX_TOKENS=1500
